(ns audio-looper.engine
  "Bounded sequenced transport and owned embedded engine. No per-block host loop."
  (:require [audio-looper.csound :as native]
            [audio-looper.dsp :as dsp]
            [audio-looper.wav :as wav]))


(defn open!
  [configuration]
  (let [instance (native/create!)]
    (try
      (when-let [created (:on-instance configuration)] (created instance))
      (native/compile! instance (dsp/document configuration))
      (native/prepare! instance)
      (native/bind-track-tables! instance (:capacity configuration 5292000))
      (doseq [{:keys [id file length-samples]} (:clips configuration)]
        (native/load-track! instance id file length-samples))
      (doseq [{:keys [table file frames]} (:prompts configuration)]
        (let [wave (wav/read! file)]
          (when-not (and (= 1 (:channels wave)) (= 44100 (:rate wave)) (= frames (:frames wave)))
            (throw (ex-info "Prompt changed after validation." {:type :engine-error :stage :assets})))
          (native/load-mono-table! instance table file frames)))
      (let [clips (into {} (for [{:keys [id length-samples]} (:clips configuration)]
                             [id {:offset-samples 0 :length-samples length-samples}]))
            gains (into {} (for [[id clip] clips]
                             [id (native/playback-gain! instance id 0 (:length-samples clip))]))]
        (native/start! instance)
        {:instance instance :configuration configuration
         :transport (atom {:event-seq 0 :next-seq 1 :in-flight nil :queue [] :held nil :last-note-id 0
                           :clips clips :playback-gains gains})})
      (catch Exception e (native/close! instance) (throw e)))))


(defn close!
  [engine]
  (native/close! (:instance engine)))


(defn enqueue!
  [engine operation]
  (when-not (get dsp/operation-codes (:type operation))
    (throw (ex-info "Unsupported engine operation." {:operation operation})))
  (let [state @(:transport engine)
        loop-id (:loop-id operation)
        clip (get-in state [:clips loop-id])
        gain (when (= :playback-start (:type operation))
               (if clip
                 (or (get-in state [:playback-gains loop-id])
                     (throw (ex-info "Ready clip has no measured playback gain."
                                     {:type :engine-error :stage :playback-gain})))
                 1.0))
        _ (when (and gain (not (<= 1.0 gain 16.0)))
            (throw (ex-info "Invalid playback makeup gain." {:type :engine-error :stage :playback-gain})))
        operation (cond-> operation gain (assoc :arg gain))]
    (swap! (:transport engine)
           (fn [state]
             (when (>= (count (:queue state)) 64)
               (throw (ex-info "Host operation queue overflow." {:type :engine-error :stage :queue})))
             (cond-> (update state :queue conj operation)
               gain (assoc-in [:playback-gains loop-id] gain)))))
  nil)


(defn discard-queued!
  [engine]
  (swap! (:transport engine) assoc :queue [])
  nil)


(defn- send-next!
  [engine]
  (let [instance (:instance engine)
        state @(:transport engine)
        in-flight (:in-flight state)
        accepted (long (native/control instance "h/ack"))
        state (if (and in-flight (= accepted (:seq in-flight))) (assoc state :in-flight nil) state)]
    (if (and (nil? (:in-flight state)) (seq (:queue state)))
      (let [operation (first (:queue state))
            sequence (:next-seq state)
            fields {"h/op" (get dsp/operation-codes (:type operation))
                    "h/id" (:id operation) "h/slot" (dec (or (:loop-id operation) 1))
                    "h/at" (or (:at-sample operation) 0) "h/length" (or (:length-samples operation) 0)
                    "h/arg" (or (:arg operation) (:cancel-operation-id operation) 0)}]
        (doseq [[channel value] fields] (native/set-control! instance channel value))
        (native/set-control! instance "h/seq" sequence)
        (reset! (:transport engine) (assoc state :queue (vec (rest (:queue state)))
                                         :next-seq (inc sequence) :in-flight {:seq sequence})))
      (reset! (:transport engine) state))))


(defn- decode
  [sequence values]
  (let [{:strs [type sample id slot a b c d e]} values
        type (get dsp/event-types (long type))
        base {:type type :sample (long sample) :seq sequence}
        id (long id) slot (long slot)]
    (when-not type (throw (ex-info "Unknown native event type." {:type :engine-error :stage :protocol})))
    (case type
      :note-on (merge base {:id id :midi (long a) :onset-sample (long b) :cents c :hz d :db e
                           :onset-time (/ b 44100.0) :confirm-time (/ sample 44100.0)})
      :note-off (merge base {:id id :end-sample (long a) :reason (if (== b 1) :silence :pitch-change)})
      :prompt-finished (assoc base :id id)
      :record-limit (assoc base :loop-id slot :operation-id id :length-samples (long a))
      :scrape (assoc base :loop-id slot :operation-id id :onset-sample (long a) :score b)
      :playback-cancelled (assoc base :loop-id slot :operation-id id
                                 :cancelled? (cond (== a 1) true (== a 0) false :else nil))
      :mixer-faded (assoc base :operation-id id)
      (merge base {:loop-id slot :operation-id id}
             (case type
               :record-started {:start-sample (long a)}
               :record-finalized {:length-samples (long a) :offset-samples (long b)
                                  :buffer [slot id (long b)]}
               (:playback-started :playback-stopped) {:at-sample (long a)}
               {})))))


(defn poll!
  "Read clock FIRST, drain the immutable ring through its committed write seq,
  acknowledge LAST. Events cannot subsequently arrive behind the reducer clock."
  [engine]
  (let [instance (:instance engine)]
    (native/check-health! instance)
    (let [clock (long (native/control instance "engine/clock"))
          written (long (native/control instance "e/write"))
          fatal (long (native/control instance "engine/fatal"))
          previous (:event-seq @(:transport engine))]
      (when (pos? fatal)
        (throw (ex-info "Native DSP rejected an operation or overflowed its bounded event ring."
                        {:type :engine-error :stage :protocol :code fatal})))
      (when-not (<= 0 (- written previous) dsp/ring-size)
        (throw (ex-info "Native event sequence gap." {:type :engine-error :stage :sequence-gap})))
      (let [events (mapv (fn [sequence]
                           (let [prefix (str "ev/" (mod sequence dsp/ring-size) "/")
                                 committed (long (native/control instance (str prefix "seq")))]
                             (when-not (= sequence committed)
                               (throw (ex-info "Native event slot is not committed." {:type :engine-error :stage :sequence-gap})))
                             (decode sequence (into {} (map #(vector % (native/control instance (str prefix %))) dsp/fields)))))
                         (range (inc previous) (inc written)))
            hz (native/control instance "pitch/hz")]
        (swap! (:transport engine)
               (fn [state]
                 (reduce (fn [state event]
                           (case (:type event)
                             :note-on (assoc state :held event :latest-note event :last-note-id (:id event))
                             :note-off (cond-> (assoc state :latest-note event)
                                         (= (:id event) (get-in state [:held :id])) (assoc :held nil))
                             :record-finalized (-> state
                                                   (assoc-in [:clips (:loop-id event)]
                                                             (select-keys event [:offset-samples :length-samples]))
                                                   (update :playback-gains dissoc (:loop-id event)))
                             (:record-started :record-cancelled :buffer-erased)
                             (-> state (update :clips dissoc (:loop-id event))
                                 (update :playback-gains dissoc (:loop-id event)))
                             state))
                         (assoc state :event-seq written) events)))
        ;; Measure while publishing a new ready clip, never on the timed play
        ;; request. A full-capacity scan must not consume its scheduling lead.
        ;; Later erase/start events in the same drain invalidate stale ranges.
        (doseq [loop-id (distinct (keep #(when (= :record-finalized (:type %)) (:loop-id %)) events))
                :let [clip (get-in @(:transport engine) [:clips loop-id])]
                :when (and clip (== (:length-samples clip)
                                    (native/control instance (str "slot/" (dec loop-id) "/length"))))]
          (let [gain (native/playback-gain! instance loop-id (:offset-samples clip) (:length-samples clip))]
            (swap! (:transport engine) assoc-in [:playback-gains loop-id] gain)))
        (native/set-control! instance "e/ack" written)
        (send-next! engine)
        {:events events :sample (max clock (or (:sample (last events)) 0))
         :ended? (native/finished? instance)
         :pitch {:hz hz :db (native/control instance "pitch/db")
                 :midi (when (<= 70 hz 1400) (long (native/control instance "pitch/midi")))
                 :cents (native/control instance "pitch/cents") :gate? (pos? (native/control instance "pitch/gate"))}
         :scrape {:score (native/control instance "scrape/score")
                  :db (native/control instance "scrape/db")
                  :noise (native/control instance "scrape/noise")
                  :threshold (native/control instance "scrape/threshold")
                  :gate? (pos? (native/control instance "scrape/gate"))
                  :calibration (long (native/control instance "scrape/calibration"))
                  :hits (long (native/control instance "scrape/hits"))
                  :detections (long (native/control instance "scrape/detections"))}}))))
