(defn- scrape-expression
  [profile]
  (str/join "+"
            (mapcat (fn [group]
                      (for [bin (range (nth scrape-edges group) (nth scrape-edges (inc group)))]
                        (format "%.12f*sin(2*PI*%.9f*t+%.5f)"
                                (* 0.006 (nth profile group))
                                (* (+ bin 0.21) (/ 44100.0 2048))
                                (* 0.1 (mod (* bin 739) 63)))))
                    (range 24))))


(defn- check-scrape!
  [owner]
  (let [template-wave (scrape-expression scrape/template)
        wave (str "if(between(t,1.5,1.9)," template-wave
                  ",if(between(t,1,1.3),0.1*sin(2*PI*220*t),0))")
        fixture (generate! owner "scrape-synth.wav" (str wave "|-1*(" wave ")") 3)
        started {:type :record-start :sample 0 :at-sample 64 :id 7}
        opts {:input fixture :capacity 132300 :duration 3 :detect? false}
        no-record (perform! opts [])
        varied-wave (str/join "+"
                              (map-indexed
                                (fn [index profile]
                                  (let [start (+ 1.5 index)]
                                    (str "if(between(t," start "," (+ start 0.3) "),("
                                         (scrape-expression profile) "),0)")))
                                scrape-training-profiles))
        varied (generate! owner "scrape-six.wav" (str varied-wave "|-1*(" varied-wave ")") 8)
        varied-result (perform! (assoc opts :input varied :duration 8) [])
        varied-matches (filter #(= :scrape (:type %)) (:events varied-result))
        recording (perform! (assoc opts :operations [started]) [])
        matches (filter #(= :scrape (:type %)) (:events recording))
        event (first matches)
        length (when event (- (:onset-sample event) 64))
        complete (when length
                   (perform! (assoc opts :operations [started {:type :record-finalize :sample 90000
                                                                :length-samples length :id 8}])
                             [[100 (- 44100 64) 128]]))
        source (wav/read! fixture)
        tone (generate! owner "scrape-negative.wav" "0.3*sin(2*PI*110*t)|0.3*sin(2*PI*110*t)" 3)
        negative (perform! (assoc opts :input tone :operations [started]) [])
        noise (.getPath (io/file (:directory @owner) "scrape-noise.wav"))
        _ (voice/run-child! owner 15000 ["ffmpeg" "-v" "error" "-y" "-f" "lavfi" "-i"
                                        "anoisesrc=color=white:amplitude=0.05:sample_rate=44100:duration=3:seed=42"
                                        "-ac" "2" "-c:a" "pcm_f32le" noise])
        noise-result (perform! (assoc opts :input noise :operations [started]) [])]
    (verify! "scrape is published globally without a recorder"
             (let [event (first (filter #(= :scrape (:type %)) (:events no-record)))]
               (and event (= 0 (:loop-id event)) (= 0 (:operation-id event)))))
    (verify! "six measured scrape profiles each produce one recognized gesture"
             (and (= 6 (count varied-matches))
                  (= [1 2 3 4 5 6]
                     (mapv #(long (/ (:onset-sample %) 44100)) varied-matches))))
    (verify! "Csound detects one phase-inverted stereo scrape with recorder correlation"
             (and (= 1 (count matches)) (= 1 (:loop-id event)) (= 7 (:operation-id event))
                  (<= 64000 (:onset-sample event) 67000) (< (:onset-sample event) (:sample event))))
    (verify! "native finalization cuts before scrape without altering recorded PCM"
             (and (= length (first (:lengths complete)))
                  (some #(= :record-finalized (:type %)) (:events complete))
                  (every? true? (map-indexed (fn [i value] (near? value (wav/sample source (+ 44100 i) 0)))
                                              (first (:tables complete))))))
    (verify! "stationary pitched tone and broadband noise do not trigger scrape"
             (and (not-any? #(= :scrape (:type %)) (:events negative))
                  (not-any? #(= :scrape (:type %)) (:events noise-result))))
    (println "PASS six-profile Csound scrape recognition, stereo power, correlation and negatives")))


(defn- check-scrape-timing!
  [owner]
  (let [sound (scrape-expression scrape/template)
        short-wave (str/join "+"
                             (map-indexed
                               (fn [index duration]
                                 (let [start (+ 1.5 index)]
                                   (str "if(between(t," start "," (+ start duration) "),(" sound "),0)")))
                               [0.02 0.04 0.06 0.08 0.10 0.12]))
        short (generate! owner "scrape-short-negatives.wav" (str short-wave "|" short-wave) 8)
        options {:input short :duration 8 :capacity 1 :detect? false}
        short-result (perform! options [])
        matches #(filter (fn [event] (= :scrape (:type event))) (:events %))
        pulse-wave (str "if(between(t,1.5,3.0)*lt(mod(t-1.5,0.14),0.06),(" sound "),0)")
        pulses (generate! owner "scrape-fragmented.wav" (str pulse-wave "|" pulse-wave) 4)
        pulse-result (perform! (assoc options :input pulses :duration 4) [])
        prefix-wave (str "if(between(t,1.5,1.56)+between(t,1.75,2.15),(" sound "),0)")
        prefix (generate! owner "scrape-prefix.wav" (str prefix-wave "|" prefix-wave) 3)
        prefix-matches (matches (perform! (assoc options :input prefix :duration 3) []))
        held-wave (str "if(between(t,1.5,1.9)+between(t,2.6,3.0)+between(t,3.8,4.2),("
                       sound "),if(between(t,1.9,2.6),0.1*sin(2*PI*220*t),0))")
        held (generate! owner "scrape-release.wav" (str held-wave "|" held-wave) 5)
        held-result (perform! (assoc options :input held :duration 5) [])]
    (verify! "20..120ms spectral lookalikes cannot trigger a scrape"
             (empty? (matches short-result)))
    (verify! "separate 60ms bursts cannot accumulate into a sustained gesture"
             (empty? (matches pulse-result)))
    (verify! "a rejected short prefix cannot backdate a later gesture's stop boundary"
             (and (= 1 (count prefix-matches))
                  (<= (* 1.70 44100) (:onset-sample (first prefix-matches)) (* 1.82 44100))
                  (>= (- (:sample (first prefix-matches)) (:onset-sample (first prefix-matches)))
                      7938)))
    (verify! "pitch change alone cannot rearm; actual quiet permits a fresh scrape"
             (= [1 3] (mapv #(quot (:onset-sample %) 44100) (matches held-result))))
    (println "PASS scrape minimum duration, burst rejection, fresh onset and quiet-only rearm")))


(defn- check-assets!
  []
  (let [cache (voice/prepare! #{} nil)
        directory (:directory @cache)]
    (try
      (verify! "owned child timeout is structured"
               (try (voice/run-child! cache 20 ["/bin/sleep" "5"])
                    false
                    (catch Exception error (= :asset-error (:type (ex-data error))))))
      (verify! "timed-out child is removed from ownership" (empty? (:children @cache)))
      (spit (io/file directory "cleanup-marker") "owned")
      (finally (voice/close! cache)))
    (verify! "voice cache recursively removes its temporary assets"
             (not (.exists (io/file directory))))
    (voice/close! cache)))


(defn check-engine!
  []
  (check-assets!)
  (let [owner (voice/prepare! #{} nil)]
    (try
      (check-pcm! owner)
      (check-silence-trim! owner)
      (check-six! owner)
      (check-capacity! owner)
      (check-voice! owner)
      (check-detector! owner)
      (check-playback-cancel! owner)
      (check-scrape! owner)
      (check-scrape-timing! owner)
      (finally (voice/close! owner)))))
