(defn- scrape-expression
  [profile]
  (str/join "+"
            (mapcat (fn [group]
                      (for [bin (range (nth scrape-edges group) (nth scrape-edges (inc group)))]
                        (format "%.12f*sin(2*PI*%.9f*t+%.5f)"
                                (* 0.006 (nth profile group))
                                (* (+ bin 0.21) (/ 44100.0 2048))
                                (* 0.1 (mod (* bin 739) 63)))))
                    (range 24))))


(defn- check-scrape!
  [owner]
  (let [template-wave (scrape-expression scrape/template)
        wave (str "if(between(t,1.5,1.9)," template-wave
                  ",if(between(t,1,1.3),0.1*sin(2*PI*220*t),0))")
        fixture (generate! owner "scrape-synth.wav" (str wave "|-1*(" wave ")") 3)
        started {:type :record-start :sample 0 :at-sample 64 :id 7}
        opts {:input fixture :capacity 132300 :duration 3 :detect? false}
        no-record (perform! opts [])
        varied-wave (str/join "+"
                              (map-indexed
                                (fn [index profile]
                                  (let [start (+ 1.5 index)]
                                    (str "if(between(t," start "," (+ start 0.3) "),("
                                         (scrape-expression profile) "),0)")))
                                scrape-training-profiles))
        varied (generate! owner "scrape-six.wav" (str varied-wave "|-1*(" varied-wave ")") 8)
        varied-result (perform! (assoc opts :input varied :duration 8) [])
        varied-matches (filter #(= :scrape (:type %)) (:events varied-result))
        recording (perform! (assoc opts :operations [started]) [])
        matches (filter #(= :scrape (:type %)) (:events recording))
        event (first matches)
        length (when event (- (:onset-sample event) 64))
        complete (when length
                   (perform! (assoc opts :operations [started {:type :record-finalize :sample 90000
                                                                :length-samples length :id 8}])
                             [[100 (- 44100 64) 128]]))
        source (wav/read! fixture)
        tone (generate! owner "scrape-negative.wav" "0.3*sin(2*PI*110*t)|0.3*sin(2*PI*110*t)" 3)
        negative (perform! (assoc opts :input tone :operations [started]) [])
        noise (.getPath (io/file (:directory @owner) "scrape-noise.wav"))
        _ (voice/run-child! owner 15000 ["ffmpeg" "-v" "error" "-y" "-f" "lavfi" "-i"
                                        "anoisesrc=color=white:amplitude=0.05:sample_rate=44100:duration=3:seed=42"
                                        "-ac" "2" "-c:a" "pcm_f32le" noise])
        noise-result (perform! (assoc opts :input noise :operations [started]) [])]
    (verify! "scrape is published globally without a recorder"
             (let [event (first (filter #(= :scrape (:type %)) (:events no-record)))]
               (and event (= 0 (:loop-id event)) (= 0 (:operation-id event)))))
    (verify! "six measured scrape profiles each produce one recognized gesture"
             (and (= 6 (count varied-matches))
                  (= [1 2 3 4 5 6]
                     (mapv #(long (/ (:onset-sample %) 44100)) varied-matches))))
    (verify! "Csound detects one phase-inverted stereo scrape with recorder correlation"
             (and (= 1 (count matches)) (= 1 (:loop-id event)) (= 7 (:operation-id event))
                  (<= 64000 (:onset-sample event) 67000) (< (:onset-sample event) (:sample event))))
    (verify! "native finalization cuts before scrape without altering recorded PCM"
             (and (= length (first (:lengths complete)))
                  (some #(= :record-finalized (:type %)) (:events complete))
                  (every? true? (map-indexed (fn [i value] (near? value (wav/sample source (+ 44100 i) 0)))
                                              (first (:tables complete))))))
    (verify! "stationary pitched tone and broadband noise do not trigger scrape"
             (and (not-any? #(= :scrape (:type %)) (:events negative))
                  (not-any? #(= :scrape (:type %)) (:events noise-result))))
    (println "PASS six-profile Csound scrape recognition, stereo power, correlation and negatives")))


(defn- check-scrape-rearm!
  [owner]
  (let [sound (scrape-expression scrape/template)
        wave (str "if(between(t,1.5,1.9)+between(t,2.6,3.0)+between(t,3.8,4.2),("
                  sound "),if(between(t,1.9,2.6),0.1*sin(2*PI*220*t),0))")
        input (generate! owner "scrape-playing-between-commands.wav" (str wave "|" wave) 5)
        result (perform! {:input input :duration 5 :capacity 1 :detect? false} [])
        matches (filter #(= :scrape (:type %)) (:events result))]
    (verify! "fresh scrapes work after ordinary playing without requiring input silence"
             (= [1 2 3] (mapv #(quot (:onset-sample %) 44100) matches)))
    (let [held-wave (str "if(between(t,1.5,3.5),(" sound "),0)")
          held (generate! owner "scrape-held.wav" (str held-wave "|" held-wave) 4)
          result (perform! {:input held :duration 4 :capacity 1 :detect? false} [])]
      (verify! "one sustained gesture stays latched instead of repeatedly triggering"
               (= 1 (count (filter #(= :scrape (:type %)) (:events result))))))
    (println "PASS fresh scrapes after ordinary playing and sustained-gesture deduplication")))


(defn- check-recorded-scrapes!
  "Optional regression against the original six-scrape FX100 capture. The raw
  PCM stays outside git; setting the variable explicitly opts into reading it."
  []
  (when-let [input (System/getenv "AUDIO_LOOPER_SIX_SCRAPES_WAV")]
    (let [wave (wav/read! input)
          duration (/ (:frames wave) 44100.0)
          _ (verify! "original six-scrape fixture is stereo 44.1 kHz and 18..20 seconds"
                     (and (= 44100 (:rate wave)) (= 2 (:channels wave)) (<= 18 duration 20)))
          result (perform! {:input input :duration duration :capacity 1 :detect? false} [])
          matches (vec (filter #(= :scrape (:type %)) (:events result)))
          windows [[2.75 3.20] [5.65 6.20] [8.25 8.90] [11.20 11.85] [14.05 14.60] [16.35 17.00]]]
      (verify! "each original FX100 scrape is recognized once with no extra detections"
               (and (= 6 (count matches))
                    (every? true? (map (fn [event [start end]]
                                        (<= (* start 44100) (:onset-sample event) (* end 44100)))
                                      matches windows))))
      (println "PASS original six-scrape FX100 recording: 6/6, no extra detections"))))


(defn- check-scrape-level-gate!
  [owner]
  (let [sound (scrape-expression scrape/template)
        wave (str "if(lt(t,1.1),0.1*sin(2*PI*220*t),"
                  "if(between(t,1.6,2.0),0.01*(" sound "),0))")
        input (generate! owner "scrape-calibration-recovery.wav" (str wave "|" wave) 3)
        result (perform! {:input input :duration 3 :capacity 1 :detect? false} [])]
    (verify! "a quiet interval recovers noise calibration after startup guitar activity"
             (= 1 (count (filter #(= :scrape (:type %)) (:events result))))))
  (let [wave "if(lt(t,1),0.0002,0.00035)*sin(2*PI*220*t)"
        input (generate! owner "scrape-noise-not-music.wav" (str wave "|" wave) 3)
        options {:input input :duration 0.95 :capacity 1 :detect? false}
        baseline (get-in (perform! options []) [:scrape :noise])
        after-playing (get-in (perform! (assoc options :duration 3) []) [:scrape :noise])]
    (verify! "ordinary playing cannot raise the learned noise floor"
             (<= after-playing (+ baseline 1.0))))
  (let [wave "if(lt(t,0.8),0.0002,if(lt(t,1.1),0.0006,if(lt(t,1.6),0.0003,0.0001)))*sin(2*PI*220*t)"
        input (generate! owner "scrape-level-hysteresis.wav" (str wave "|" wave) 2)
        options {:input input :duration 1.4 :capacity 1 :detect? false}
        held (:scrape (perform! options []))
        released (:scrape (perform! (assoc options :duration 1.9) []))]
    (verify! "an open level gate holds through modest envelope dips"
             (and (:gate? held) (< (:db held) (:threshold held))
                  (>= (:db held) (- (:threshold held) 3))))
    (verify! "the level gate closes after a real envelope release" (false? (:gate? released))))
  (println "PASS scrape noise recovery, music-resistant floor and level hysteresis"))


(defn- check-current-scrape-recording!
  "Opt-in regression for the 18.51-second live-failure capture: two clear
  late scrapes and known normal notes at the beginning. The weak 8.9s transient
  is deliberately not promoted to a required command by weakening the matcher."
  []
  (when-let [input (System/getenv "AUDIO_LOOPER_CURRENT_SCRAPES_WAV")]
    (let [wave (wav/read! input)
          duration (/ (:frames wave) 44100.0)
          _ (verify! "current diagnostic fixture is stereo 44.1 kHz and 18..20 seconds"
                     (and (= 44100 (:rate wave)) (= 2 (:channels wave)) (<= 18 duration 20)))
          record-start (* 11 44100)
          result (perform! {:input input :duration duration :capacity (* 8 44100) :detect? false
                            :operations [{:type :record-start :sample (- record-start 64)
                                          :at-sample record-start :id 7}]} [])
          matches (filter #(= :scrape (:type %)) (:events result))
          in-window? (fn [event [start end]]
                       (<= (* start 44100) (:onset-sample event) (* end 44100)))]
      (doseq [window [[12.15 12.55] [14.40 14.90]]]
        (verify! "a clear current FX100 scrape crosses the level gate exactly once"
                 (= 1 (count (filter #(in-window? % window) matches)))))
      (verify! "current ordinary-note passage does not become a scrape"
               (not-any? #(in-window? % [0 4.5]) matches))
      (let [event (first (filter #(in-window? % [12.15 12.55]) matches))
            state (-> (control/initial-state)
                      (assoc :sample record-start :event-seq (dec (:seq event)) :active-recorder 1)
                      (assoc-in [:slots 0 :record-state] :recording)
                      (assoc-in [:slots 0 :record-start-id] 7)
                      (assoc-in [:slots 0 :start-sample] record-start))
            [stopping effects] (control/step state event)]
        (verify! "the real weak-scrape event stops the correlated active recorder"
                 (and (= 1 (:loop-id event)) (= 7 (:operation-id event))
                      (= :record-finalize (:type (first effects)))
                      (= (:onset-sample event) (get-in stopping [:slots 0 :pending :boundary-sample]))
                      (= :empty (get-in stopping [:slots 0 :clip-state])))))
      (println "PASS current FX100 capture: clear scrapes stop the correlated recorder; normal notes rejected")))
  (when-let [input (System/getenv "AUDIO_LOOPER_SCRAPE_NOISE_WAV")]
    (let [wave (wav/read! input)
          duration (/ (:frames wave) 44100.0)
          _ (verify! "noise-only fixture is bounded stereo 44.1 kHz"
                     (and (= 44100 (:rate wave)) (= 2 (:channels wave)) (<= 1 duration 30)))
          result (perform! {:input input :duration duration :capacity 1 :detect? false} [])]
      (verify! "current FX100 noise-only capture does not trigger"
               (not-any? #(= :scrape (:type %)) (:events result)))
      (println "PASS current FX100 noise-only recording: no detections"))))


(defn- check-assets!
  []
  (let [cache (voice/prepare! #{} nil)
        directory (:directory @cache)]
    (try
      (verify! "owned child timeout is structured"
               (try (voice/run-child! cache 20 ["/bin/sleep" "5"])
                    false
                    (catch Exception error (= :asset-error (:type (ex-data error))))))
      (verify! "timed-out child is removed from ownership" (empty? (:children @cache)))
      (spit (io/file directory "cleanup-marker") "owned")
      (finally (voice/close! cache)))
    (verify! "voice cache recursively removes its temporary assets"
             (not (.exists (io/file directory))))
    (voice/close! cache)))


(defn check-engine!
  []
  (check-assets!)
  (let [owner (voice/prepare! #{} nil)]
    (try
      (check-pcm! owner)
      (check-playback-level! owner)
      (check-silence-trim! owner)
      (check-six! owner)
      (check-capacity! owner)
      (check-voice! owner)
      (check-detector! owner)
      (check-playback-cancel! owner)
      (check-scrape! owner)
      (check-recorded-scrapes!)
      (check-current-scrape-recording!)
      (check-scrape-rearm! owner)
      (check-scrape-level-gate! owner)
      (finally (voice/close! owner)))))
