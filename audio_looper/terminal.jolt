(ns audio-looper.terminal
  "Foreground terminal I/O only. The stage-2 preview never opens an audio stream."
  (:require
    [audio-looper.control :as control]
    [audio-looper.csound :as native]
    [audio-looper.dashboard :as dashboard]
    [audio-looper.engine :as engine]
    [audio-looper.runtime :as runtime]
    [audio-looper.sessions :as sessions]
    [audio-looper.setup :as setup]
    [audio-looper.voice :as voice]
    [clojure.string :as str]
    [jolt.process :as process]))


(defn- stty!
  [& arguments]
  (let [child (apply process/process {:out :string :err :string}
                     "/bin/stty" "-f" "/dev/tty" arguments)]
    (try
      (let [result (deref child 2000 ::timeout)]
        (when (or (= ::timeout result) (not (zero? (:exit result))))
          (throw (ex-info "Cannot configure/restore the owned terminal."
                          {:type :terminal-error :detail (:err result)})))
        (str/trim (:out result)))
      (finally
        (when (.isAlive (:proc child))
          (process/destroy-tree child)
          (deref child 1000 nil))))))


(declare close!)


(defn open!
  [no-tui?]
  (let [interactive? (and (native/tty? 0) (native/tty? 1))
        ansi? (and interactive? (not no-tui?) (not= "dumb" (System/getenv "TERM")))
        terminal (atom {:interactive? interactive? :ansi? ansi? :closed? false :saved nil})
        hook (Thread. (fn [] (close! terminal)))]
    (swap! terminal assoc :hook hook)
    (.addShutdownHook (Runtime/getRuntime) hook)
    (try
      (locking terminal
        (when interactive?
          (swap! terminal assoc :saved (stty! "-g"))
          ;; Keep ISIG enabled: Ctrl+C must remain a foreground safety signal.
          (stty! "-icanon" "-echo" "-ixon" "isig" "min" "1" "time" "0"))
        (when ansi? (print "\u001b[?1049h\u001b[?25l") (flush)))
      terminal
      (catch Exception e
        (close! terminal)
        (throw e)))))


(defn close!
  [terminal]
  (locking terminal
    (when-not (:closed? @terminal)
      (let [{:keys [saved ansi? hook]} @terminal]
        (swap! terminal assoc :closed? true)
        (try
          (when saved (stty! saved))
          (finally
            (when ansi? (print "\u001b[0m\u001b[?25h\u001b[?1049l") (flush))
            (.removeShutdownHook (Runtime/getRuntime) hook))))))
  nil)


(defn- write!
  [text]
  (print text)
  (flush))


(defn- line!
  [terminal deadline]
  (loop [characters []]
    (when (>= (System/nanoTime) deadline)
      (throw (ex-info "UI session reached its safety time limit." {:type :session-limit})))
    (let [key (native/read-key! 100)]
      (cond
        (or (= :eof key) (= \u0004 key)) :eof
        (#{\newline \return} key) (do (write! "\n") (apply str characters))
        (and (empty? characters) (#{\q \c} key)) (do (write! (str key "\n")) (str key))
        (#{\backspace \u007f} key)
        (do (when (seq characters) (write! "\b \b")) (recur (vec (butlast characters))))
        (and key (<= 32 (int key) 126))
        (if (< (count characters) 128)
          (do (when (:interactive? @terminal) (write! (str key))) (recur (conj characters key)))
          (throw (ex-info "Setup input exceeds 128 characters." {:type :input-overflow})))
        :else (recur characters)))))


(defn- refresh-session
  [session]
  (let [inventory (native/audio-devices!)
        resolve-one (fn [direction selected]
                      (let [matches (filter #(= (:uid selected) (:uid %)) (get inventory direction))]
                        (when-not (= 1 (count matches))
                          (throw (ex-info "Selected audio device disappeared; restart selection."
                                          {:type :device-unavailable :uid (:uid selected)})))
                        (first matches)))]
    (assoc session :input (resolve-one :inputs (:input session))
           :output (resolve-one :outputs (:output session)))))


(defn- prepare-cache!
  [cache]
  (when-not @cache
    (write! "Preparing finite voice prompts before audio starts...\n")
    (reset! cache (voice/prepare!)))
  nil)


(defn- capture-setup!
  [terminal deadline state cache]
  (prepare-cache! cache)
  (write! "\nOpening the selected input for profile selection/setup capture; monitoring is off.\n")
  (let [session (refresh-session (select-keys state [:input :output]))
        remaining (max 1.0 (min 600.0 (/ (- deadline (System/nanoTime)) 1e9)))
        running (engine/open! {:live? true :input-device (get-in session [:input :id])
                               :output-device (get-in session [:output :id])
                               :input-channels (min 2 (get-in session [:input :channels]))
                               :duration remaining :capacity control/capacity-samples
                               :prompts [] :monitor? false :detect? true})]
    (try
      (loop [state state rendered nil]
        (when (>= (System/nanoTime) deadline)
          (throw (ex-info "UI session reached its safety time limit." {:type :session-limit})))
        (if-not (#{:profile :profile-release :scale :wake} (:stage state))
          state
          (let [display (select-keys state [:stage :scale :wake :message :profile-choice])]
            (when-not (= display rendered)
              (when (:ansi? @terminal) (write! "\u001b[H\u001b[2J"))
              (write! (str (str/join "\n" (map dashboard/safe-text (setup/prompt state true))) "\n")))
            (let [key (native/read-key! 10)
                  keyboard-choice? (and (= :profile (:stage state))
                                         (#{\1 \2 \3 \newline \return} key))
                  _ (when (and keyboard-choice? (:interactive? @terminal))
                      (write! (if (#{\newline \return} key) "\n" (str key "\n"))))
                  next-state
                  (cond
                    (or (= :eof key) (= \u0004 key) (= \q key))
                    (setup/step state {:type :line :text "q"})
                    (= \c key) (setup/step state {:type :line :text "c"})
                    keyboard-choice?
                    (setup/step state {:type :line
                                       :text (if (#{\newline \return} key) "" (str key))})
                    :else
                    (let [snapshot (engine/poll! running)]
                      (when (:ended? snapshot)
                        (throw (ex-info "Setup capture engine ended unexpectedly."
                                        {:type :engine-error :stage :setup-capture})))
                      (let [state (reduce (fn [state event]
                                            (if (#{:note-on :note-off} (:type event))
                                              (setup/step state event) state))
                                          state (:events snapshot))]
                        (setup/step state {:type :tick :sample (:sample snapshot)}))))]
              (recur next-state display)))))
      (finally (engine/close! running)))))


(defn- configure!
  [terminal deadline live-capture? cache & [saved-profile]]
  (loop [state (assoc (setup/initial-state (native/audio-devices!)) :saved-profile saved-profile)]
    (when (:ansi? @terminal) (write! "\u001b[H\u001b[2J"))
    (write! (str (str/join "\n" (map dashboard/safe-text
                                       (setup/prompt state live-capture?))) "\n"))
    (case (:stage state)
      :ready (setup/resolve-session state (native/audio-devices!))
      :quit nil
      :error (throw (ex-info (:message state) {:type :device-unavailable}))
      :profile (if live-capture?
                 (recur (capture-setup! terminal deadline state cache))
                 (let [line (line! terminal deadline)]
                   (when-not (= :eof line)
                     (recur (setup/step state {:type :line :text line})))))
      (:profile-release :scale :wake)
      (recur (if live-capture?
               (capture-setup! terminal deadline state cache)
               (setup/step state {:type :capture-unavailable})))
      (let [line (line! terminal deadline)]
        (when-not (= :eof line)
          (recur (setup/step state {:type :line :text line})))))))


(defn- choose-session!
  "Browse metadata, then validate/lock a chosen load before device setup.
  New directories wait until setup succeeds; this menu never opens audio."
  [terminal deadline]
  (loop [stage :choose page 0 message nil]
    (let [entries (sessions/list! sessions/default-root)
          pages (max 1 (long (Math/ceil (/ (count entries) 10.0))))
          page (min page (dec pages))
          visible (vec (take 10 (drop (* page 10) entries)))]
      (when (:ansi? @terminal) (write! "\u001b[H\u001b[2J"))
      (write! (str "LOOPER SESSIONS\nStorage: " (dashboard/safe-text sessions/default-root) "\n"
                   (if (= stage :choose)
                     "[Enter/n] New session   [l] Load previous session   [q] Quit\n"
                     (str "Previous sessions (page " (inc page) "/" pages "):\n"
                          (str/join "\n"
                                    (map-indexed
                                      (fn [i entry]
                                        (str (inc i) ". "
                                             (dashboard/safe-text
                                               (if (:error entry) (str (:directory entry) " [unavailable: " (:error entry) "]")
                                                 (str (get-in entry [:metadata :id]) "  tracks="
                                                      (count (get-in entry [:metadata :tracks]))))))) visible))
                          "\nNumber to load; ] next page; [ previous page; b back; q quit.\n"))
                   (when message (str (dashboard/safe-text message) "\n"))))
      (let [line (line! terminal deadline)]
        (cond
          (or (= :eof line) (= "q" line)) nil
          (and (= stage :choose) (#{"" "n"} line)) {:new? true}
          (and (= stage :choose) (= "l" line)) (recur :list 0 nil)
          (and (= stage :list) (= "]" line)) (recur :list (min (inc page) (dec pages)) nil)
          (and (= stage :list) (= "[" line)) (recur :list (max 0 (dec page)) nil)
          (= "b" line) (recur :choose 0 nil)
          (and (= stage :list) (re-matches #"[0-9]+" line))
          (let [index (parse-long line)
                entry (when (and index (<= 1 index (count visible))) (nth visible (dec index)))
                result (when (and entry (not (:error entry)))
                         (try {:store (sessions/open! (:directory entry))}
                              (catch Exception error {:error (ex-message error)})))]
            (if (:store result) result
              (recur :list page (or (:error result) (:error entry) "Choose a valid session number."))))
          :else (recur stage page "Choose one of the displayed options."))))))


(defn- default-preview-session
  [inventory]
  {:input (or (first (filter :default? (:inputs inventory))) (first (:inputs inventory))
              {:name "unavailable" :id "--"})
   :output (or (first (filter :default? (:outputs inventory))) {:name "unavailable" :id "--"})
   :profile control/default-profile :monitor? false :headphones? false})


(defn list-devices!
  []
  (let [inventory (native/audio-devices!)]
    (println "CoreAudio metadata only; no audio stream opened.")
    (doseq [[label devices] [["INPUT" (:inputs inventory)] ["OUTPUT" (:outputs inventory)]]
            device devices]
      (println label (dashboard/safe-text (:id device))
               (dashboard/safe-text (:name device)) (str "channels=" (:channels device))
               (when (:default? device) "[default]")
               (str "uid=" (dashboard/safe-text (:uid device)))))
    inventory))


(defn- warn-live!
  [session]
  (write! (str "\nSTARTING LIVE PCM LOOPER\nInput: "
               (dashboard/safe-text (get-in session [:input :name]))
               "\nOutput: " (dashboard/safe-text (get-in session [:output :name]))
               "\nSetup is complete; the looper engine opens now. Restored tracks remain stopped."
               "\nKeep strings muted until scrape noise calibration completes (~1 second after audio starts)."
               "\nUse low volume/headphones; avoid direct-monitor doubling and feedback.\n")))


(defn- live-engine!
  [terminal deadline session cache store]
  (let [session (refresh-session session)
        initial (merge (runtime/initial-state (:profile session))
                       (sessions/restore-state (:metadata @store)))
        remaining (max 1.0 (min 600.0 (/ (- deadline (System/nanoTime)) 1e9)))
        running (engine/open! {:live? true :input-device (get-in session [:input :id])
                               :output-device (get-in session [:output :id])
                               :input-channels (min 2 (get-in session [:input :channels]))
                               :duration remaining :capacity control/capacity-samples
                               :prompts (:entries @cache) :monitor? (:monitor? session)
                               :clips (sessions/clips store) :detect? true})
        running (assoc running :session-store store)]
    (try
      (loop [state initial debug? false
             renderer (dashboard/renderer (:ansi? @terminal)) reconfigure? false]
        (let [snapshot (engine/poll! running)
              key (native/read-key! 10)
              configure? (and (= \c key) (setup/reconfigurable? state))
              quit? (or (= :eof key) (= \u0004 key) (= \q key) configure?
                        (>= (System/nanoTime) deadline))
              [state exit-code] (runtime/advance! running cache state snapshot quit?)
              context (merge session (native/terminal-size!)
                             {:session-id (get-in @store [:metadata :id])
                              :preview? false :debug? debug? :pitch (:pitch snapshot) :scrape (:scrape snapshot)})
              [renderer frame] (dashboard/plan renderer (dashboard/view state context)
                                                 (quot (System/nanoTime) 1000000))]
          (when frame (write! frame))
          (if (some? exit-code)
            {:exit-code exit-code :reconfigure? (or reconfigure? configure?)}
            (recur state (if (= \d key) (not debug?) debug?) renderer
                   (or reconfigure? configure?)))))
      (finally (engine/close! running)))))


(defn live!
  "The only full live entrypoint. Explicit --live plus a real foreground TTY is
  the opening gate; all callers before this function are metadata/offline only."
  [no-tui?]
  (native/arm-wall-clock! 600)
  (let [deadline (+ (System/nanoTime) 599000000000)
        terminal (open! no-tui?)
        cache (atom nil)
        store (atom nil)]
    (try
      (when-not (:interactive? @terminal)
        (throw (ex-info "--live requires foreground terminal input and output." {:type :terminal-required})))
      (when-let [choice (choose-session! terminal deadline)]
        (reset! store (:store choice))
        (loop [session (configure! terminal deadline true cache
                                   (when @store (get-in @@store [:metadata :profile])))]
          (when session
            (if @store
              (let [before (sessions/restore-state (:metadata @@store))
                    after (assoc before :profile (:profile session))]
                (sessions/checkpoint! @store nil before after))
              (reset! store (sessions/create! sessions/default-root (:profile session))))
            (write! (str "Session: " (dashboard/safe-text (:directory @@store)) "\n"))
            (warn-live! session)
            (prepare-cache! cache)
            (let [{:keys [exit-code reconfigure?]} (live-engine! terminal deadline session @cache @store)]
              (when-not (zero? exit-code)
                (throw (ex-info "Live engine exited with an error." {:exit exit-code})))
              (when reconfigure?
                (recur (configure! terminal deadline true cache)))))))
      (finally
        (try
          (when @cache (voice/close! @cache))
          (finally
            (try (sessions/close! @store)
                 (finally (close! terminal))))))))
  nil)


(defn preview!
  "Interactive keyboard setup/dashboard on a TTY; one plain snapshot when
  redirected. No synthetic guitar events, fake clips, recording, or playback."
  [no-tui?]
  (native/arm-wall-clock! 600)
  (let [deadline (+ (System/nanoTime) 599000000000)
        terminal (open! no-tui?)]
    (try
      (when-let [session (if (:interactive? @terminal) (configure! terminal deadline false nil)
                             (default-preview-session (native/audio-devices!)))]
        (loop [state (control/initial-state (:profile session))
               session session debug? false renderer (dashboard/renderer (:ansi? @terminal))]
          (let [now (System/nanoTime)
                context (merge session (native/terminal-size!) {:preview? true :debug? debug?})
                [renderer frame] (dashboard/plan renderer (dashboard/view state context) (quot now 1000000))]
            (when frame (write! frame))
            (when (and (:interactive? @terminal) (< now deadline))
              (let [key (native/read-key! 20)]
                (cond
                  (or (= :eof key) (= \u0004 key) (= \q key)) nil
                  (= \d key) (recur state session (not debug?) renderer)
                  (= \c key)
                  (if (setup/reconfigurable? state)
                    (when-let [changed (configure! terminal deadline false nil)]
                      (recur (control/initial-state (:profile changed)) changed debug?
                             (dashboard/renderer (:ansi? @terminal))))
                    (recur state session debug? renderer))
                  :else (recur state session debug? renderer)))))))
      (finally (close! terminal))))
  nil)
