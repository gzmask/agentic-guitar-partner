(ns audio-looper.scrape
  "Csound-only experimental scrape recognition. The profile is an aggregated,
  normalized spectral fingerprint of six varied FX100 low-E scrapes; it contains
  no PCM samples.")


(def template
  ;; Normalized mean of six low-E scrapes with varied speed, force and contact
  ;; position, captured through the same FX100/pickup/preset chain.
  [0.112743500303 0.121087651445 0.085181933136 0.084229325660
   0.121964636807 0.186716522000 0.234081597938 0.271175604696
   0.416010373511 0.283124493506 0.304914529312 0.115688671340
   0.090915027988 0.126824726643 0.086602404609 0.081340056164
   0.133546715828 0.277095797653 0.512499329000 0.087556949517
   0.077252019491 0.068916579022 0.074811137324 0.030125743724])


(def orchestra
  "; Stereo power matching avoids cancellation when left/right are out of phase.
instr 11
  iL ftgen 0, 0, -1025, -2, 0
  iR ftgen 0, 0, -1025, -2, 0
  fL pvsanal gaInL, 2048, 441, 2048, 1
  fR pvsanal gaInR, 2048, 441, 2048, 1
  kL pvsftw fL, iL
  kR pvsftw fR, iR
  krL rms gaInL, 20
  krR rms gaInR, 20
  kdb = 20*log10(max(sqrt((krL*krL+krR*krR)*0.5), 0.000000000001))
  kstart[] fillarray 42,47,51,56,61,67,72,78,85,91,99,106,114,123,132,141,151,162,173,185,198,211,225,240
  kend[] fillarray 47,51,56,61,67,72,78,85,91,99,106,114,123,132,141,151,162,173,185,198,211,225,240,256
  khist[] init 121
  knoise init -90
  kcal init 0
  khits init 0
  kframes init 0
  kbegin init -1
  kfirst init -1
  klast init -1
  klatched init 0
  kreleased init -1
  kcooldown init 0
  if kL == 1 && kR == 1 then
    if kcal < 80 then
      kbin = int(limit(kdb+120, 0, 120))
      khist[kbin] = khist[kbin]+1
      kcal = kcal+1
      ktarget = ceil(kcal*0.2)
      ki = 0
      kcount = 0
      while ki < 121 && kcount < ktarget do
        kcount = kcount+khist[ki]
        ki = ki+1
      od
      knoise = limit(ki-121, -110, -30)
    else
      if kdb < knoise+6 then
        knoise = max(-110, knoise+0.005*(kdb-knoise))
      endif
      ksum = 0
      klog = 0
      kweighted = 0
      khigh = 0
      kdot = 0
      knorm = 0
      ki = 42
      while ki < 256 do
        ka table ki, iL
        kb table ki, iR
        kp = (ka*ka+kb*kb)*0.5 + 0.00000000000000000001
        ksum = ksum+kp
        klog = klog+log(kp)
        kweighted = kweighted+kp*ki*44100/2048
        if ki >= 93 then
          khigh = khigh+kp
        endif
        ki = ki+1
      od
      kflat = exp(klog/214)/(ksum/214)
      kentropy = 0
      ki = 42
      while ki < 256 do
        ka table ki, iL
        kb table ki, iR
        kp = ((ka*ka+kb*kb)*0.5 + 0.00000000000000000001)/ksum
        kentropy = kentropy-kp*log(kp)
        ki = ki+1
      od
      kentropy = kentropy/log(214)
      kg = 0
      while kg < 24 do
        ki = kstart[kg]
        kband = 0
        while ki < kend[kg] do
          ka table ki, iL
          kb table ki, iR
          kband = kband+(ka*ka+kb*kb)*0.5
          ki = ki+1
        od
        kval = sqrt(kband/(kend[kg]-kstart[kg]))
        knorm = knorm+kval*kval
        kt table kg, 800
        kdot = kdot+kval*kt
        kg = kg+1
      od
      kscore = kdot/max(sqrt(knorm), 0.00000000000000000001)
      ; Spectral similarity alone is not a command. Prefer missed short/quiet
      ; gestures over allowing an incidental attack to stop or exit the looper.
      kgood = (kscore >= 0.90 && kdb >= max(-100,knoise+12) && kflat >= 0.02 && kentropy >= 0.48 && kweighted/max(ksum,0.00000000000000000001) >= 400 && khigh/max(ksum,0.00000000000000000001) >= 0.03 ? 1 : 0)
      chnset kscore, \"scrape/score\"
      chnset kdb, \"scrape/db\"
      chnset knoise, \"scrape/noise\"
      krecording = 0
      if gkRecSlot >= 0 then
        if gkRec[gkRecSlot] == 1 || gkRec[gkRecSlot] == 2 then
          krecording = 1
        endif
      endif
      if klatched == 1 then
        ; A different spectrum is not release. Require actual input quiet for
        ; 120 ms, as well as the existing 650 ms cooldown, before rearming.
        if kdb >= max(-100,knoise+6) then
          kreleased = -1
        elseif kreleased < 0 then
          kreleased = gkClock
        elseif gkClock >= kcooldown && gkClock-kreleased >= 5292 then
          klatched = 0
        endif
      else
        ; Bound each candidate to 250 ms and at most 40 ms between matches
        ; (one 32-sample block of tolerance for FFT-hop/block alignment).
        if kbegin >= 0 then
          if gkClock-kbegin > 11025 || gkClock-klast > 1796 then
            khits = 0
            kframes = 0
            kbegin = -1
            kfirst = -1
            klast = -1
          endif
        endif
        if kgood == 1 then
          if kbegin < 0 then
            kbegin = gkClock
            kfirst = max(0, gkClock-2048)
          endif
          khits = khits+1
          klast = gkClock
        endif
        if kbegin >= 0 then
          kframes = kframes+1
        endif
        ; Time is measured from the analysis frame, NOT its backdated onset.
        ; At least 180 ms, 16 hits and 80% occupancy are all required together.
        if kgood == 1 && kbegin >= 0 && gkClock-kbegin >= 7938 && khits >= 16 && khits >= 0.8*kframes then
          if krecording == 1 then
            Emit 12, gkClock, gkRecId[gkRecSlot], gkRecSlot+1, kfirst, kscore, 0, 0, 0
          else
            Emit 12, gkClock, 0, 0, kfirst, kscore, 0, 0, 0
          endif
          klatched = 1
          kcooldown = gkClock+28665
          kreleased = -1
          khits = 0
          kframes = 0
          kbegin = -1
          kfirst = -1
          klast = -1
        endif
      endif
    endif
  endif
endin")
