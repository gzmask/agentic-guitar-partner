(ns audio-looper.scrape
  "Csound-only experimental scrape recognition. The profile is an aggregated,
  normalized spectral fingerprint of six varied FX100 low-E scrapes; it contains
  no PCM samples.")


(def template
  ;; Normalized mean of six low-E scrapes with varied speed, force and contact
  ;; position, captured through the same FX100/pickup/preset chain.
  [0.112743500303 0.121087651445 0.085181933136 0.084229325660
   0.121964636807 0.186716522000 0.234081597938 0.271175604696
   0.416010373511 0.283124493506 0.304914529312 0.115688671340
   0.090915027988 0.126824726643 0.086602404609 0.081340056164
   0.133546715828 0.277095797653 0.512499329000 0.087556949517
   0.077252019491 0.068916579022 0.074811137324 0.030125743724])


(def orchestra
  "; Stereo power matching avoids cancellation when left/right are out of phase.
instr 11
  iL ftgen 0, 0, -1025, -2, 0
  iR ftgen 0, 0, -1025, -2, 0
  fL pvsanal gaInL, 2048, 441, 2048, 1
  fR pvsanal gaInR, 2048, 441, 2048, 1
  kL pvsftw fL, iL
  kR pvsftw fR, iR
  krL rms gaInL, 20
  krR rms gaInR, 20
  kdb = 20*log10(max(sqrt((krL*krL+krR*krR)*0.5), 0.000000000001))
  kstart[] fillarray 42,47,51,56,61,67,72,78,85,91,99,106,114,123,132,141,151,162,173,185,198,211,225,240
  kend[] fillarray 47,51,56,61,67,72,78,85,91,99,106,114,123,132,141,151,162,173,185,198,211,225,240,256
  khist[] init 121
  klevels[] init 80
  kcursor init 0
  knoise init -90
  kcal init 0
  klevel init 0
  kdetected init 0
  khits init 0
  kfirst init -1
  klast init -1
  klatched init 0
  kreleased init -1
  kcooldown init 0
  if kL == 1 && kR == 1 then
    ; Keep an 80-frame histogram, not an RMS average that learns guitar tails
    ; as background. After warmup only quieter percentile estimates may lower
    ; the floor; a later quiet interval can repair a contaminated startup.
    kready = (kcal >= 80 ? 1 : 0)
    kbin = int(limit(kdb+120, 0, 120))
    if kcal < 80 then
      kcal = kcal+1
    else
      khist[klevels[kcursor]] = khist[klevels[kcursor]]-1
    endif
    klevels[kcursor] = kbin
    kcursor = (kcursor+1)%80
    khist[kbin] = khist[kbin]+1
    ktarget = ceil(kcal*0.2)
    ki = 0
    kcount = 0
    while ki < 121 && kcount < ktarget do
      kcount = kcount+khist[ki]
      ki = ki+1
    od
    kestimate = limit(ki-121, -110, -30)
    if kready == 0 then
      knoise = kestimate
    else
      knoise = min(knoise,kestimate)
    endif
    kopen = max(-100,knoise+6)
    if kready == 1 then
      ; Measured weak FX100 scrapes cross +6 dB but dip during their envelope.
      ; Hold to +3 dB instead of discarding every dip as the old +10 dB gate did.
      if klevel == 0 then
        if kdb >= kopen then
          klevel = 1
        endif
      elseif kdb < kopen-3 then
        klevel = 0
      endif
      ksum = 0
      klog = 0
      kweighted = 0
      khigh = 0
      kdot = 0
      knorm = 0
      ki = 42
      while ki < 256 do
        ka table ki, iL
        kb table ki, iR
        kp = (ka*ka+kb*kb)*0.5 + 0.00000000000000000001
        ksum = ksum+kp
        klog = klog+log(kp)
        kweighted = kweighted+kp*ki*44100/2048
        if ki >= 93 then
          khigh = khigh+kp
        endif
        ki = ki+1
      od
      kflat = exp(klog/214)/(ksum/214)
      kentropy = 0
      ki = 42
      while ki < 256 do
        ka table ki, iL
        kb table ki, iR
        kp = ((ka*ka+kb*kb)*0.5 + 0.00000000000000000001)/ksum
        kentropy = kentropy-kp*log(kp)
        ki = ki+1
      od
      kentropy = kentropy/log(214)
      kg = 0
      while kg < 24 do
        ki = kstart[kg]
        kband = 0
        while ki < kend[kg] do
          ka table ki, iL
          kb table ki, iR
          kband = kband+(ka*ka+kb*kb)*0.5
          ki = ki+1
        od
        kval = sqrt(kband/(kend[kg]-kstart[kg]))
        knorm = knorm+kval*kval
        kt table kg, 800
        kdot = kdot+kval*kt
        kg = kg+1
      od
      kscore = kdot/max(sqrt(knorm), 0.00000000000000000001)
      ; Keep the measured fingerprint, shape guards and eight-hit confirmation.
      ; The level gate has separate opening/release thresholds, like note input.
      kgood = (kscore >= 0.90 && klevel == 1 && kflat >= 0.02 && kentropy >= 0.48 && kweighted/max(ksum,0.00000000000000000001) >= 400 && khigh/max(ksum,0.00000000000000000001) >= 0.03 ? 1 : 0)
      krecording = 0
      if gkRecSlot >= 0 then
        if gkRec[gkRecSlot] == 1 || gkRec[gkRecSlot] == 2 then
          krecording = 1
        endif
      endif
      if klatched == 1 then
        if kgood == 1 then
          kreleased = -1
        elseif kreleased < 0 then
          kreleased = gkClock
        elseif gkClock >= kcooldown && gkClock-kreleased >= 5292 then
          klatched = 0
        endif
      else
        if kgood == 1 then
          if kfirst < 0 then
            kfirst = max(0, gkClock-2048)
            khits = 0
          endif
          khits = khits+1
          klast = gkClock
        elseif klast >= 0 && gkClock-klast > 1764 then
          khits = 0
          kfirst = -1
          klast = -1
        endif
        if khits >= 8 then
          if krecording == 1 then
            Emit 12, gkClock, gkRecId[gkRecSlot], gkRecSlot+1, kfirst, kscore, 0, 0, 0
          else
            Emit 12, gkClock, 0, 0, kfirst, kscore, 0, 0, 0
          endif
          kdetected = kdetected+1
          klatched = 1
          kcooldown = gkClock+28665
          khits = 0
          kfirst = -1
          klast = -1
        endif
      endif
    endif
    chnset kscore, \"scrape/score\"
    chnset kdb, \"scrape/db\"
    chnset knoise, \"scrape/noise\"
    chnset kopen, \"scrape/threshold\"
    chnset klevel, \"scrape/gate\"
    chnset kcal, \"scrape/calibration\"
    chnset khits, \"scrape/hits\"
    chnset kdetected, \"scrape/detections\"
  endif
endin")
